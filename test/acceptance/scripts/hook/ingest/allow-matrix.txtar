# Every agent's everyday read and write events parse and persist with the
# right action type. A parser regression here silently drops audit data.
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share

stdin claude_read.json
exec gryph _hook claude-code PostToolUse
stdin claude_write.json
exec gryph _hook claude-code PreToolUse
exec gryph query --agent claude-code --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin cursor_read.json
exec gryph _hook cursor beforeReadFile
stdin cursor_edit.json
exec gryph _hook cursor afterFileEdit
exec gryph query --agent cursor --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin gemini_read.json
exec gryph _hook gemini BeforeTool
stdin gemini_write.json
exec gryph _hook gemini BeforeTool
exec gryph query --agent gemini --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin opencode_read.json
exec gryph _hook opencode tool.execute.before
stdin opencode_write.json
exec gryph _hook opencode tool.execute.before
exec gryph query --agent opencode --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin windsurf_read.json
exec gryph _hook windsurf pre_read_code
stdin windsurf_write.json
exec gryph _hook windsurf pre_write_code
exec gryph query --agent windsurf --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin piagent_read.json
exec gryph _hook pi-agent tool_call
stdin piagent_write.json
exec gryph _hook pi-agent tool_call
exec gryph query --agent pi-agent --format json --no-color
stdout '"ActionType": "file_read"'
stdout '"ActionType": "file_write"'

stdin codex_bash.json
exec gryph _hook codex PostToolUse
exec gryph query --agent codex --format json --no-color
stdout '"ActionType": "command_exec"'

stdin devin_bash.json
exec gryph _hook devin PostToolUse
exec gryph query --agent devin --format json --no-color
stdout '"ActionType": "command_exec"'

exec gryph sessions --format json --no-color
stdout -count=8 '"ID"'

-- claude_read.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PostToolUse",
  "tool_name": "Read",
  "tool_input": {
    "file_path": "/home/user/project/README.md"
  },
  "tool_response": {
    "content": "# Project README",
    "success": true
  },
  "tool_use_id": "tool-use-003"
}
-- claude_write.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Write",
  "tool_input": {
    "file_path": "/home/user/project/src/main.go",
    "content": "package main"
  },
  "tool_use_id": "tool-use-002"
}
-- cursor_read.json --
{
  "conversation_id": "conv-test-123",
  "generation_id": "gen-006",
  "model": "claude-3-opus",
  "hook_event_name": "beforeReadFile",
  "cursor_version": "0.44.0",
  "workspace_roots": ["/home/user/project"],
  "user_email": "user@example.com",
  "file_path": "/home/user/project/README.md"
}
-- cursor_edit.json --
{
