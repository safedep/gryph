# The service goes away while a hook waits on it. A stop with SIGTERM
# drains the open request: the hook gets its answer, here pending, because
# nobody answered the prompt. A kill with SIGKILL cannot drain, and the
# client treats the lost connection as the fail mode of the hook: a
# blocking hook blocks, with the one stderr line of an absent service, and
# leaves the decision in the spool with the cause. The hook here waits on
# the terminal for an approval, so the service is in the middle of its
# request when it goes. Runs only in the privileged job on a Linux host.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
[!exec:python3] skip 'needs python3 for a pseudo terminal'
! exists /etc/safedep/gryph
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
expandenv managed.yml
exec install -D -m 644 $WORK/managed.yml /etc/safedep/gryph/config.yml
exec install -m 644 policy.yaml /etc/safedep/gryph/policy.yaml
exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir $WORK/state --spool-dir $WORK/spool --allow-root &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock

# The hook asks on the terminal and nobody answers. The helper marks the
# moment the question shows. The service stops at that moment and drains.
env TERMINAL_PROMPTED=$WORK/prompted-stop
exec sh -c 'python3 terminal.py - npm.json gryph _hook claude-code PreToolUse; echo "code=$?"' &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock --until-exists $WORK/prompted-stop
exec gryph supervisor stop --pid-file $WORK/state/supervisor.pid
wait
stdout 'Approve\? \[y/N\]'
stdout 'Request [0-9a-f]{8} is pending'
! stdout 'Gryph supervisor is not running'
stdout 'code=2'
! exists $WORK/spool/0

# The same request under a kill: no answer comes, the hook blocks and the
# spool keeps the decision with the cause.
# The kill ends the service with a signal, which the harness counts as a
# failure of the command.
! exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir $WORK/state --spool-dir $WORK/spool --allow-root &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock
env TERMINAL_PROMPTED=$WORK/prompted-kill
exec sh -c 'python3 terminal.py - npm.json gryph _hook claude-code PreToolUse; echo "code=$?"' &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock --until-exists $WORK/prompted-kill
exec gryph supervisor stop --pid-file $WORK/state/supervisor.pid --kill
wait
stdout 'Approve\? \[y/N\]'
stdout 'Gryph supervisor is not running\. Run `gryph doctor`\.'
stdout 'code=2'
exec sh -c 'cat $WORK/spool/0/*.json'
stdout -count=1 '"verdict":"block"'
stdout 'ipc'

exec rm -rf /etc/safedep/gryph /root/.local/share/safedep /root/.config/safedep /root/.cache/safedep /tmp/gryph-acceptance-hook.sock
exec rmdir --ignore-fail-on-non-empty /etc/safedep
-- managed.yml --
policy:
  enabled: true
  approval:
    channels: [same-user-tty, local-admin]
    min_assurance: same-user-tty
    inline_wait: 3s
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
-- policy.yaml --
version: "1"
rules:
  - id: acceptance-escalate-npm
    action: escalate
    severity: high
    min_assurance: same-user-tty
    match:
      action_types: [command_exec]
      command_patterns:
        - "(?i)\\bnpm\\s+install\\b"
    message: npm install needs approval
-- npm.json --
{
  "session_id": "test-session-killed",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "npm install", "description": "install"},
  "tool_use_id": "tool-use-k1"
}
-- terminal.py --
# Run a hook with a pseudo terminal as its controlling terminal and answer
# the approval prompt there.
# usage: python3 terminal.py <answer|-> <payload|-> <command...>
# The payload file is the stdin of the hook, or a dash keeps the stdin of
# the helper. Stdout and stderr of the hook
# are pipes, as under an agent. The terminal gets the answer when a
# question that ends in [y/N] shows, and TERMINAL_PASSWORD when a line
# that ends in "Password:" shows. A dash gives no answer. A command that
# stays silent for a minute is killed. Everything the hook writes goes to
# stdout, and the exit code is the hook's. When TERMINAL_PROMPTED names a
# file, the helper creates it as soon as the question shows, so a script
# can act while the hook waits.
import os
import pty
import select
import sys

answer, payload, command = sys.argv[1], sys.argv[2], sys.argv[3:]
out_r, out_w = os.pipe()
err_r, err_w = os.pipe()
pid, fd = pty.fork()
if pid == 0:
    # One descriptor keeps the terminal open after the standard ones
    # change, else the master reads end of file before the prompt.
    os.set_inheritable(os.dup(0), True)
    if payload != "-":
        os.dup2(os.open(payload, os.O_RDONLY), 0)
    os.dup2(out_w, 1)
    os.dup2(err_w, 2)
    os.execvp(command[0], command)
os.close(out_w)
os.close(err_w)
seen = b""
sent = False
password = os.environ.get("TERMINAL_PASSWORD")
password_sent = False
prompted = os.environ.get("TERMINAL_PROMPTED")
open_fds = {fd, out_r, err_r}
while open_fds:
    ready, _, _ = select.select(list(open_fds), [], [], 60)
    if not ready:
        os.kill(pid, 9)
        break
    for r in ready:
        try:
            data = os.read(r, 4096)
        except OSError:
            data = b""
        if not data:
            open_fds.discard(r)
            continue
        sys.stdout.write(data.decode("utf-8", "replace"))
        sys.stdout.flush()
        if r == fd:
            seen += data
            if prompted and b"[y/N]" in seen:
                os.close(os.open(prompted, os.O_CREAT | os.O_WRONLY, 0o644))
                prompted = None
            if not sent and answer != "-" and b"[y/N]" in seen:
                os.write(fd, (answer + "\n").encode())
                sent = True
            if password and not password_sent and b"Password:" in seen:
                os.write(fd, (password + "\n").encode())
                password_sent = True
_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
