# A socket that accepts the connect and never sends welcome is an absent
# service: the client gives up within the handshake budget and a blocking
# hook blocks. A successful connect alone proves nothing, because socket
# activation accepts a connect while the service is down. Runs only in the
# privileged job on a Linux host with no managed state.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
! exists /etc/safedep/gryph
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
expandenv managed.yml
exec install -D -m 644 $WORK/managed.yml /etc/safedep/gryph/config.yml

exec gryph supervisor fake --socket /tmp/gryph-acceptance-hook.sock --no-welcome &
ipcframe hello.bin hello.json
stdin hello.bin
! exec gryph supervisor send --socket /tmp/gryph-acceptance-hook.sock --timeout 2s

stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr '^Gryph supervisor is not running\. Run `gryph doctor`\.$'
exec sh -c 'cat $WORK/spool/0/*.json'
stdout '"verdict":"block"'
stdout 'no welcome'

exec rm -rf /etc/safedep/gryph
exec rmdir --ignore-fail-on-non-empty /etc/safedep

-- managed.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
-- hello.json --
{"type":"hello","body":{"proto":1}}
-- bash.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "ls -la", "description": "list"},
  "tool_use_id": "tool-use-b1"
}
