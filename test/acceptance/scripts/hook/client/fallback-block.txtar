# Under a managed configuration with supervisor.enabled, the hook is a
# client of the decision service. With no service at the socket, a
# blocking hook blocks with one stderr line, and an allowed hook of the
# same session still goes through as the fail-mode column says. The hook
# opens no store in client mode. Runs only in the privileged job on a
# Linux host with no managed state.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
! exists /etc/safedep/gryph
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
expandenv managed.yml
exec install -D -m 644 $WORK/managed.yml /etc/safedep/gryph/config.yml

stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr '^Gryph supervisor is not running\. Run `gryph doctor`\.$'
! exists $XDG_DATA_HOME/safedep/gryph/audit.db

# The administrator can make a blocking hook allow instead.
expandenv allow.yml
exec install -m 644 $WORK/allow.yml /etc/safedep/gryph/config.yml
stdin bash.json
exec gryph _hook claude-code PreToolUse
! stderr .

# Without supervisor.enabled the managed host decides in process.
expandenv off.yml
exec install -m 644 $WORK/off.yml /etc/safedep/gryph/config.yml
stdin bash.json
exec gryph _hook claude-code PreToolUse

exec rm -rf /etc/safedep/gryph /root/.local/share/safedep /root/.config/safedep /root/.cache/safedep
exec rmdir --ignore-fail-on-non-empty /etc/safedep

-- managed.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
-- allow.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
  unavailable:
    blocking: allow
-- off.yml --
supervisor:
  enabled: false
-- bash.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "ls -la", "description": "list"},
  "tool_use_id": "tool-use-b1"
}
