# A same-user process cannot stand in for the decision service. The hook
# client refuses a socket whose directory another account owns, and a
# socket whose peer is not root or the service account, in every mode: a
# blocking hook blocks with one stderr line, and the spool carries the
# finding as a tamper event. The check never turns into the absent-service
# fallback: a prompt hook, which an absent service allows, blocks here.
# The same client accepts the socket of a root service. Runs only in the
# privileged job on a Linux host with the useradd tools.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
[!exec:useradd] skip 'needs useradd'
! exists /etc/safedep/gryph
! exists /home/gryphacc1
! exists /usr/local/bin/gryph-acceptance
! exists /tmp/gryph-acceptance-user
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
exec cp $ACCEPTANCE_GRYPH_BIN /usr/local/bin/gryph-acceptance
exec useradd -m -s /bin/bash gryphacc1

# A socket in a directory the user owns fails the path chain.
exec mkdir -m 755 /tmp/gryph-acceptance-user
exec chown gryphacc1:gryphacc1 /tmp/gryph-acceptance-user
expandenv userdir.yml
exec install -D -m 644 $WORK/userdir.yml /etc/safedep/gryph/config.yml
# The user's fake service reads its reply from a file the user can read:
# $WORK is private to root.
exec cp allow.json /tmp/gryph-acceptance-user/allow.json
exec chmod 644 /tmp/gryph-acceptance-user/allow.json
# The user's service starts detached, because runuser does not stop on the
# interrupt that the script sends at its end. The script stops every
# process of the user before it removes the account.
exec runuser -u gryphacc1 -- /bin/sh -c '/usr/local/bin/gryph-acceptance supervisor fake --socket /tmp/gryph-acceptance-user/hook.sock --reply /tmp/gryph-acceptance-user/allow.json >/dev/null 2>&1 &'

ipcframe hello.bin hello.json
stdin hello.bin
exec gryph supervisor send --socket /tmp/gryph-acceptance-user/hook.sock --text --timeout 5s
stdout '"type":"welcome"'
stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr 'Gryph refused the decision service at /tmp/gryph-acceptance-user/hook.sock: .*not owned by root'
stdin prompt.json
execexit 2 gryph _hook claude-code UserPromptSubmit
stderr 'Gryph refused the decision service'

# A socket that the user owns fails on its owner, whatever its directory.
exec chmod 1777 /tmp/gryph-acceptance-user
exec chown root:root /tmp/gryph-acceptance-user
stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr 'Gryph refused the decision service at /tmp/gryph-acceptance-user/hook.sock: .*hook.sock is not owned by root'

# A root-owned socket in a sticky directory passes the chain, so the peer
# decides: the user's process is not root and not the service account.
exec chown root:root /tmp/gryph-acceptance-user/hook.sock
stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr 'Gryph refused the decision service at /tmp/gryph-acceptance-user/hook.sock: .*socket peer runs as uid [0-9]+, (not as root or _gryph|and the service account _gryph is unknown)'

exec sh -c 'cat $WORK/spool/0/*.json'
stdout -count=4 '"kind":"tamper"'
stdout '"verdict":"block"'

# The socket of a root service passes.
exec gryph supervisor fake --socket /tmp/gryph-acceptance-user/root.sock --reply $WORK/allow.json &
expandenv rootsock.yml
exec install -m 644 $WORK/rootsock.yml /etc/safedep/gryph/config.yml
stdin bash.json
exec gryph _hook claude-code PreToolUse
! stderr .

exec rm -rf /etc/safedep/gryph /tmp/gryph-acceptance-user
exec rmdir --ignore-fail-on-non-empty /etc/safedep
exec sh -c 'pkill -u gryphacc1; sleep 0.2; true'
exec userdel -r gryphacc1
exec rm -f /usr/local/bin/gryph-acceptance

-- userdir.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-user/hook.sock
  spool_dir: ${WORK}/spool
-- rootsock.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-user/root.sock
  spool_dir: ${WORK}/spool
-- allow.json --
{"type":"decision","body":{"decision":"allow"}}
-- hello.json --
{"type":"hello","body":{"proto":1}}
-- bash.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "ls -la", "description": "list"},
  "tool_use_id": "tool-use-b1"
}
-- prompt.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "UserPromptSubmit",
  "prompt": "list the files"
}
