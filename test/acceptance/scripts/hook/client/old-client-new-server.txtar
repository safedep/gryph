# A service that answers with a verdict this binary does not know, or
# with a frame that is not a decision, makes the client block: version
# skew during an upgrade never turns into an allow. After the handshake a
# rate limit blocks a blocking hook too. Runs only in the privileged job
# on a Linux host with no managed state.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
! exists /etc/safedep/gryph
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
expandenv managed.yml
exec install -D -m 644 $WORK/managed.yml /etc/safedep/gryph/config.yml

exec gryph supervisor fake --socket /tmp/gryph-acceptance-hook.sock --reply defer.json &
ipcframe hello.bin hello.json
stdin hello.bin
exec gryph supervisor send --socket /tmp/gryph-acceptance-hook.sock --text
stdout '"type":"welcome"'

stdin bash.json
execexit 2 gryph _hook claude-code PreToolUse
stderr 'unknown decision "defer"'

# A prompt hook with the same unknown verdict blocks too: the service
# answered, so this is not the absent-service case.
stdin prompt.json
execexit 2 gryph _hook claude-code UserPromptSubmit
stderr 'unknown decision "defer"'

exec rm -rf /etc/safedep/gryph
exec rmdir --ignore-fail-on-non-empty /etc/safedep

-- managed.yml --
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
-- hello.json --
{"type":"hello","body":{"proto":1}}
-- defer.json --
{"type":"decision","body":{"decision":"defer","reason":"a newer verdict"}}
-- bash.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "ls -la", "description": "list"},
  "tool_use_id": "tool-use-b1"
}
-- prompt.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "UserPromptSubmit",
  "prompt": "list the files"
}
