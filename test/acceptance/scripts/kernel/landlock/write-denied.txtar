# gryph run starts a program under a Landlock ruleset: the configuration
# directory of Gryph stays readable and takes no write from the program
# and from anything it starts, whatever path a write takes. The rest of
# the file system stays as it is, except that the program cannot create a
# new entry directly inside an ancestor of the protected directory. A hook
# that runs under the ruleset still records its event. The census tells an
# agent that started through the launcher from one that did not. Needs a
# Linux kernel with Landlock. No root.
[!linux] skip 'Landlock is a Linux API'
[!landlock] skip 'needs a kernel with Landlock and a seccomp filter that lets it through'
env GRYPH_POLICY_SELF_PROTECTION_CENSUS=true
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $HOME/.claude
exec gryph install --agent claude-code

# An account that never ran gryph has no configuration directory. The
# launcher makes it before the ruleset, so the program cannot make its
# own, and the ruleset covers it.
! exec sh -c 'HOME='$WORK'/fresh XDG_CONFIG_HOME='$WORK'/fresh/.config XDG_DATA_HOME='$WORK'/fresh/.local/share gryph run sh -c "echo x > '$WORK'/fresh/.config/safedep/gryph/config.yml"'
stderr 'Permission denied'
exists $WORK/fresh/.config/safedep/gryph
! exists $WORK/fresh/.config/safedep/gryph/config.yml

# A write to the policy by any path fails. A read passes.
! exec gryph run sh -c 'echo "# changed" >> '$XDG_CONFIG_HOME'/safedep/gryph/policy.yaml'
stderr 'Permission denied'
! exec gryph run sh -c 'cp /dev/null '$XDG_CONFIG_HOME'/safedep/gryph/config.yml'
stderr 'Permission denied'
! exec gryph run sh -c 'mv '$XDG_CONFIG_HOME'/safedep/gryph '$XDG_CONFIG_HOME'/safedep/elsewhere'
stderr 'Permission denied'
! exec gryph run python3 -c 'open("'$XDG_CONFIG_HOME'/safedep/gryph/policy.yaml", "a").write("x")'
exec gryph run sh -c 'cat '$XDG_CONFIG_HOME'/safedep/gryph/policy.yaml'
stdout 'acceptance-landlock-marker'
exec cat $XDG_CONFIG_HOME/safedep/gryph/policy.yaml
! stdout 'changed'

# Every launch carries the ruleset: the kernel attaches it to one thread,
# and the launcher runs the program from that thread.
exec sh -c 'for i in $(seq 1 25); do gryph run sh -c "echo changed >> '$XDG_CONFIG_HOME'/safedep/gryph/policy.yaml" 2>/dev/null; done; cat '$XDG_CONFIG_HOME'/safedep/gryph/policy.yaml'
! stdout 'changed'

# The project and the data directory stay writable, so a hook under the
# ruleset records its event. The kernel keeps a new entry out of the
# ancestors of the protected directory.
exec gryph run sh -c 'echo ok > '$WORK'/project/out.txt && cat '$WORK'/project/out.txt'
stdout 'ok'
! exec gryph run sh -c 'echo x > '$XDG_CONFIG_HOME'/new.txt'
stderr 'Permission denied'
stdin read.json
exec gryph run sh -c 'gryph _hook claude-code PreToolUse'
exec gryph query --agent claude-code --format json --no-color
stdout '"file_read"'

# The census tells an agent under the launcher from one outside it. The
# agent here is a script named like the Claude Code program, which marks
# its start and waits. The marker sits in the project directory, because
# the work directory is an ancestor of the protected directory. The host
# that runs the suite may run a Claude Code of its own, so the counts are
# not fixed.
exec install -m 755 claude $WORK/bin/claude
env PATH=$WORK/bin${:}$PATH
exec gryph run claude-code $WORK/project/started-run &
exec gryph supervisor ready --until-exists $WORK/project/started-run
exec gryph doctor --no-color
stdout 'hook_traffic\s+claude-code\s+detect\s+[0-9]+ process\(es\), pid [0-9 ]+, ([0-9]+ of [0-9]+ )?under gryph run'
exec $WORK/bin/claude $WORK/project/started-plain &
exec gryph supervisor ready --until-exists $WORK/project/started-plain
exec gryph doctor --no-color
stdout 'hook_traffic\s+claude-code\s+detect\s+[0-9]+ process\(es\), pid [0-9 ]+, 1 of [0-9]+ under gryph run'

# A program that is not on PATH is an error, and a kernel without Landlock
# is reported, never a start without the ruleset.
! exec gryph run no-such-program-7q
stderr 'no-such-program-7q is not on PATH'

-- bin/.keep --
-- claude --
#!/bin/sh
# gryph doctor probes the version of the program on PATH when it runs as
# a user, so a version flag answers at once.
case "$1" in -v|--version) echo "1.0.0 (Claude Code)"; exit 0;; esac
# The harness ends the agent with an interrupt at the end of the script.
# The shell forwards it to the sleep, so no process holds the pipes.
touch "$1"
sleep 300 &
child=$!
trap 'kill $child 2>/dev/null; exit 0' INT TERM
wait $child
-- project/.keep --
-- home/.config/safedep/gryph/config.yml --
policy:
  enabled: true
-- home/.config/safedep/gryph/policy.yaml --
version: "1"
rules:
  - id: acceptance-landlock-marker
    action: warn
    match:
      action_types: [file_write]
    message: marker
-- read.json --
{"session_id": "s-landlock", "cwd": "/home/user/project", "hook_event_name": "PreToolUse", "tool_name": "Read",
 "tool_input": {"file_path": "/home/user/project/main.go"}, "tool_use_id": "tu-read"}
