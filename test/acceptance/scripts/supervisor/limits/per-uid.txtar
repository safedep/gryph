# One account cannot hold more connections than the limit: the newest one
# above it gets error rate_limited and closes. A flood of requests over
# the rate gets error rate_limited too, and the service records one
# tamper event in the system session of the account. Another account's
# service is untouched. Runs only in the privileged job on a Linux host.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the account tools of this script are the Linux ones'
[!exec:useradd] skip 'needs useradd'
! exists /home/gryphacc1
! exists /usr/local/bin/gryph-acceptance
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share

exec cp $ACCEPTANCE_GRYPH_BIN /usr/local/bin/gryph-acceptance
exec useradd -m -s /bin/bash gryphacc1
exec id -u gryphacc1
cp stdout uid1.txt
capture UID1 '([0-9]+)' uid1.txt

exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir $WORK/state --allow-root --max-conns 3 --rate 2 &

# Root holds three connections. The fourth is refused at once.
ipcframe hello.bin hello.json
stdin hello.bin
exec gryph supervisor send --socket /tmp/gryph-acceptance-hook.sock --text --idle 3
stdout '"type":"error","body":\{"code":"rate_limited","message":"too many connections from this account"'

# Root floods requests: the bucket of four runs dry.
ipcframe flood.bin hello.json handle.json handle.json handle.json handle.json handle.json handle.json
stdin flood.bin
exec gryph supervisor send --socket /tmp/gryph-acceptance-hook.sock --text
stdout '"type":"decision"'
stdout '"code":"rate_limited","message":"too many requests from this account"'

# The other account is not affected.
ipcframe frames.bin hello.json handle.json
exec cp frames.bin /tmp/gryph-acceptance-frames.bin
exec chmod 644 /tmp/gryph-acceptance-frames.bin
exec runuser -u gryphacc1 -- /bin/sh -c '/usr/local/bin/gryph-acceptance supervisor send --socket /tmp/gryph-acceptance-hook.sock --text < /tmp/gryph-acceptance-frames.bin'
stdout '"type":"decision","body":\{"decision":"allow"\}'
! stdout 'rate_limited'

# The flood became one tamper event in root's system session.
env GRYPH_DATA_DIR=$WORK/state/users/0
exec gryph policy receipts --format json --no-color
stdout -count=1 '"decision":\s*"tamper"'
stdout 'supervisor rate_limited'

exec userdel -r gryphacc1
exec rm -f /usr/local/bin/gryph-acceptance /tmp/gryph-acceptance-frames.bin

-- hello.json --
{"type":"hello","body":{"proto":1,"client_version":"test"}}
-- handle.json --
{"type":"handle","body":{"agent":"claude-code","hook_type":"PreToolUse","raw_payload":"eyJzZXNzaW9uX2lkIjoidGVzdC1zZXNzaW9uLTEyMyIsImN3ZCI6Ii9ob21lL3VzZXIvcHJvamVjdCIsImhvb2tfZXZlbnRfbmFtZSI6IlByZVRvb2xVc2UiLCJ0b29sX25hbWUiOiJSZWFkIiwidG9vbF9pbnB1dCI6eyJmaWxlX3BhdGgiOiIvaG9tZS91c2VyL3Byb2plY3QvbWFpbi5nbyJ9LCJ0b29sX3VzZV9pZCI6InRvb2wtdXNlLXIxIn0=","project_claim":{"name":"project"}}}
