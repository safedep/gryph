# The service keys every partition on the account that the kernel reports
# for the peer, never on a field of a request. Two accounts that send the
# same frames get two partitions, and a client cannot name another one.
# Runs only in the privileged job on a Linux host with the useradd tools.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the account tools of this script are the Linux ones'
[!exec:useradd] skip 'needs useradd'
! exists /home/gryphacc1
! exists /home/gryphacc2
! exists /usr/local/bin/gryph-acceptance
! exists /tmp/gryph-acceptance-hook.sock
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share

# The clients run as other accounts, so the binary and the socket must sit
# where every account can reach them. The test binary lives in a private
# directory, and so does $WORK.
exec cp $ACCEPTANCE_GRYPH_BIN /usr/local/bin/gryph-acceptance
exec useradd -m -s /bin/bash gryphacc1
exec useradd -m -s /bin/bash gryphacc2
exec id -u gryphacc1
cp stdout uid1.txt
capture UID1 '([0-9]+)' uid1.txt
exec id -u gryphacc2
cp stdout uid2.txt
capture UID2 '([0-9]+)' uid2.txt

exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir $WORK/state --allow-root &

ipcframe frames.bin hello.json handle.json
exec cp frames.bin /tmp/gryph-acceptance-frames.bin
exec chmod 644 /tmp/gryph-acceptance-frames.bin
exec runuser -u gryphacc1 -- /bin/sh -c '/usr/local/bin/gryph-acceptance supervisor send --socket /tmp/gryph-acceptance-hook.sock --text < /tmp/gryph-acceptance-frames.bin'
stdout '"type":"decision","body":\{"decision":"allow"\}'
exec runuser -u gryphacc2 -- /bin/sh -c '/usr/local/bin/gryph-acceptance supervisor send --socket /tmp/gryph-acceptance-hook.sock --text < /tmp/gryph-acceptance-frames.bin'
stdout '"type":"decision","body":\{"decision":"allow"\}'

exists $WORK/state/users/$UID1/audit.db
exists $WORK/state/users/$UID2/audit.db
! exists $WORK/state/users/0

# Each partition holds its own session, and nothing of the other.
env GRYPH_DATA_DIR=$WORK/state/users/$UID1
exec gryph sessions --format json --no-color
stdout -count=1 '"AgentName": "claude-code"'
env GRYPH_DATA_DIR=$WORK/state/users/$UID2
exec gryph sessions --format json --no-color
stdout -count=1 '"AgentName": "claude-code"'

exec userdel -r gryphacc1
exec userdel -r gryphacc2
exec rm -f /usr/local/bin/gryph-acceptance /tmp/gryph-acceptance-frames.bin

-- hello.json --
{"type":"hello","body":{"proto":1,"client_version":"test"}}
-- handle.json --
{"type":"handle","body":{"agent":"claude-code","hook_type":"PreToolUse","raw_payload":"eyJzZXNzaW9uX2lkIjoidGVzdC1zZXNzaW9uLTEyMyIsImN3ZCI6Ii9ob21lL3VzZXIvcHJvamVjdCIsImhvb2tfZXZlbnRfbmFtZSI6IlByZVRvb2xVc2UiLCJ0b29sX25hbWUiOiJSZWFkIiwidG9vbF9pbnB1dCI6eyJmaWxlX3BhdGgiOiIvaG9tZS91c2VyL3Byb2plY3QvbWFpbi5nbyJ9LCJ0b29sX3VzZV9pZCI6InRvb2wtdXNlLXIxIn0=","project_claim":{"name":"project"}}}
