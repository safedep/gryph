# A session binds to the first known agent process above its hooks. A
# hook of the same session from outside that agent, while it lives, is a
# low-trust connection: an escalate rule that would ask on the terminal
# asks nobody there, the request waits for an approver above the
# terminal, and the receipt and the request record the trust. Runs only
# in the privileged job on a Linux host.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
[!exec:python3] skip 'needs python3 for a pseudo terminal'
! exists /etc/safedep/gryph
! exists /tmp/gryph-acceptance-agents
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
mkdir $WORK/spool
expandenv managed.yml
exec install -D -m 644 $WORK/managed.yml /etc/safedep/gryph/config.yml
exec install -m 644 policy.yaml /etc/safedep/gryph/policy.yaml
exec mkdir -p /tmp/gryph-acceptance-agents
exec cp $ACCEPTANCE_GRYPH_BIN /usr/local/bin/gryph-acceptance
exec cp read.json /tmp/gryph-acceptance-agents/read.json
exec cp prompt.json /tmp/gryph-acceptance-agents/prompt.json
exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir $WORK/state --spool-dir $WORK/spool --allow-root &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock

# A process named like the agent runs the first hooks of the session and
# stays alive, as an agent does. The session binds to it.
exec install -m 755 claude /tmp/gryph-acceptance-agents/claude
# Detached, so the harness holds no pipe of a process that outlives it.
exec sh -c '/tmp/gryph-acceptance-agents/claude >/dev/null 2>&1 &'
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock --until-exists /tmp/gryph-acceptance-agents/done
exists /tmp/gryph-acceptance-agents/done
exec gryph sessions --format json --no-color
stdout '"agent_process": "claude:[0-9]+:[0-9]+"'

# The same session from a plain shell, with a terminal ready to type y:
# no prompt, the request waits.
execexit 2 python3 terminal.py y npm.json gryph _hook claude-code PreToolUse
! stdout 'Approve'
stdout 'Request [0-9a-f]{8} is pending\. The connection is not under the agent of the session, so only an approver answers\.'
exec gryph policy approve list --format json --no-color
stdout '"state": "pending"'
stdout '"requester_trust": "low"'
stdout '"min_assurance": "local-admin"'
stdout '"inline": false'
exec gryph policy approve history --format json --no-color
stdout '"peer_trust": "low"'
exec gryph policy receipts --format json --no-color
stdout '"peer_trust": "agent"'
stdout '"peer_trust": "low"'

exec gryph supervisor stop --pid-file $WORK/state/supervisor.pid
exec sh -c 'pkill -KILL -f "acceptance-agents/claud[e]"; true'
exec rm -rf /etc/safedep/gryph /tmp/gryph-acceptance-agents /usr/local/bin/gryph-acceptance /root/.local/share/safedep /root/.config/safedep /root/.cache/safedep
exec rmdir --ignore-fail-on-non-empty /etc/safedep
-- managed.yml --
policy:
  enabled: true
  log_all_evaluations: true
  approval:
    channels: [same-user-tty, local-admin]
    min_assurance: local-admin
    inline_wait: 3s
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: ${WORK}/spool
-- policy.yaml --
version: "1"
rules:
  - id: acceptance-escalate-npm
    action: escalate
    severity: high
    min_assurance: same-user-tty
    match:
      action_types: [command_exec]
      command_patterns:
        - "(?i)\\bnpm\\s+install\\b"
    message: "npm install needs approval"
-- read.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Read",
  "tool_input": {"file_path": "/home/user/project/main.go"},
  "tool_use_id": "tool-use-r1"
}
-- npm.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "npm install", "description": "Install dependencies"},
  "tool_use_id": "tool-use-001"
}
-- prompt.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "UserPromptSubmit",
  "prompt": "fix the build"
}
-- claude --
#!/bin/sh
# Stands in for the agent: one hook, then it stays alive.
/usr/local/bin/gryph-acceptance _hook claude-code PreToolUse < /tmp/gryph-acceptance-agents/read.json
touch /tmp/gryph-acceptance-agents/done
while :; do sleep 1; done
-- terminal.py --
# Run a hook with a pseudo terminal as its controlling terminal and answer
# the approval prompt there.
# usage: python3 terminal.py <answer|-> <payload|-> <command...>
# The payload file is the stdin of the hook, or a dash keeps the stdin of
# the helper. Stdout and stderr of the hook
# are pipes, as under an agent. The terminal gets the answer when a
# question that ends in [y/N] shows, and TERMINAL_PASSWORD when a line
# that ends in "Password:" shows. A dash gives no answer. A command that
# stays silent for a minute is killed. Everything the hook writes goes to
# stdout, and the exit code is the hook's.
import os
import pty
import select
import sys

answer, payload, command = sys.argv[1], sys.argv[2], sys.argv[3:]
out_r, out_w = os.pipe()
err_r, err_w = os.pipe()
pid, fd = pty.fork()
if pid == 0:
    # One descriptor keeps the terminal open after the standard ones
    # change, else the master reads end of file before the prompt.
    os.set_inheritable(os.dup(0), True)
    if payload != "-":
        os.dup2(os.open(payload, os.O_RDONLY), 0)
    os.dup2(out_w, 1)
    os.dup2(err_w, 2)
    os.execvp(command[0], command)
os.close(out_w)
os.close(err_w)
seen = b""
sent = False
password = os.environ.get("TERMINAL_PASSWORD")
password_sent = False
open_fds = {fd, out_r, err_r}
while open_fds:
    ready, _, _ = select.select(list(open_fds), [], [], 60)
    if not ready:
        os.kill(pid, 9)
        break
    for r in ready:
        try:
            data = os.read(r, 4096)
        except OSError:
            data = b""
        if not data:
            open_fds.discard(r)
            continue
        sys.stdout.write(data.decode("utf-8", "replace"))
        sys.stdout.flush()
        if r == fd:
            seen += data
            if not sent and answer != "-" and b"[y/N]" in seen:
                os.write(fd, (answer + "\n").encode())
                sent = True
            if password and not password_sent and b"Password:" in seen:
                os.write(fd, (password + "\n").encode())
                password_sent = True
_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
