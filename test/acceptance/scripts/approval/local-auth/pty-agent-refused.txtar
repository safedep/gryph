# An agent that types y on a pseudo terminal does not know the password
# of the approver: the service refuses the answer, and the request stays
# pending. Only the managed configuration can waive the password, with
# allow_without_auth, and the answer is then local-admin, not local-auth.
# Runs only in the privileged job on a Linux host with a system bus and
# polkit.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the account tools of this script are the Linux ones'
[!exec:useradd] skip 'needs useradd'
[!exec:python3] skip 'needs python3 for a pseudo terminal'
[!polkit] skip 'needs a system bus with polkit and pkttyagent'
! exists /etc/safedep/gryph
! exists /home/gryphacc1
! exists /home/gryphacc2
! exists /usr/local/bin/gryph-acceptance
! exists /usr/share/polkit-1/actions/io.safedep.gryph.policy
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
exec cp $ACCEPTANCE_GRYPH_BIN /usr/local/bin/gryph-acceptance
exec groupadd gryph-acceptance-admins
exec useradd -m -s /bin/bash gryphacc1
exec useradd -m -s /bin/bash -G gryph-acceptance-admins gryphacc2
exec sh -c 'echo gryphacc2:gryph-acceptance-pw | chpasswd'
exec install -D -m 644 managed.yml /etc/safedep/gryph/config.yml
exec install -m 644 policy.yaml /etc/safedep/gryph/policy.yaml
exec install -m 644 io.safedep.gryph.policy /usr/share/polkit-1/actions/io.safedep.gryph.policy
exec cp deploy.json /tmp/gryph-acceptance-deploy.json
exec cp deploy2.json /tmp/gryph-acceptance-deploy2.json
exec cp terminal.py /tmp/gryph-acceptance-terminal.py
exec chmod 644 /tmp/gryph-acceptance-deploy.json /tmp/gryph-acceptance-deploy2.json /tmp/gryph-acceptance-terminal.py
exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir /tmp/gryph-acceptance-state --spool-dir /tmp/gryph-acceptance-spool --allow-root &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock

# The requester has no terminal: the request waits for an approver.
! exec runuser -u gryphacc1 -- env HOME=/home/gryphacc1 XDG_CONFIG_HOME=/home/gryphacc1/.config XDG_DATA_HOME=/home/gryphacc1/.local/share /bin/sh -c '/usr/local/bin/gryph-acceptance _hook claude-code PreToolUse < /tmp/gryph-acceptance-deploy.json'
stderr 'Request [0-9a-f]{8} is pending'
exec runuser -u gryphacc2 -- env HOME=/home/gryphacc2 XDG_CONFIG_HOME=/home/gryphacc2/.config XDG_DATA_HOME=/home/gryphacc2/.local/share /bin/sh -c '/usr/local/bin/gryph-acceptance policy approve list --format json --no-color'
cp stdout list.json
capture REQ '"id": "([0-9a-f]{8})' list.json

# y on the confirmation and nothing for the password: refused.
! exec runuser -u gryphacc2 -- env TERMINAL_PASSWORD=not-the-password HOME=/home/gryphacc2 XDG_CONFIG_HOME=/home/gryphacc2/.config XDG_DATA_HOME=/home/gryphacc2/.local/share /bin/sh -c 'python3 /tmp/gryph-acceptance-terminal.py y - /usr/local/bin/gryph-acceptance policy approve resolve --id '$REQ' --decision allow'
stdout 'the answer needs the password of the approver'
exec runuser -u gryphacc2 -- env HOME=/home/gryphacc2 XDG_CONFIG_HOME=/home/gryphacc2/.config XDG_DATA_HOME=/home/gryphacc2/.local/share /bin/sh -c '/usr/local/bin/gryph-acceptance policy approve show '$REQ' --no-color'
stdout 'state +pending'

# The managed configuration waives the password: the service restarts
# with it, and the answer counts without one, at a lower assurance.
exec gryph supervisor stop --pid-file /tmp/gryph-acceptance-state/supervisor.pid
exec install -m 644 waived.yml /etc/safedep/gryph/config.yml
exec gryph supervisor run --socket /tmp/gryph-acceptance-hook.sock --state-dir /tmp/gryph-acceptance-state --spool-dir /tmp/gryph-acceptance-spool --allow-root &
exec gryph supervisor ready --socket /tmp/gryph-acceptance-hook.sock
exec runuser -u gryphacc2 -- env TERMINAL_PASSWORD=not-the-password HOME=/home/gryphacc2 XDG_CONFIG_HOME=/home/gryphacc2/.config XDG_DATA_HOME=/home/gryphacc2/.local/share /bin/sh -c 'python3 /tmp/gryph-acceptance-terminal.py y - /usr/local/bin/gryph-acceptance policy approve resolve --id '$REQ' --decision allow'
stdout 'is approved \(self-elevated\), grant [0-9a-f]{8}'

exec gryph supervisor stop --pid-file /tmp/gryph-acceptance-state/supervisor.pid
exec rm -rf /etc/safedep/gryph /tmp/gryph-acceptance-state /tmp/gryph-acceptance-spool /tmp/gryph-acceptance-hook.sock /tmp/gryph-acceptance-deploy.json /tmp/gryph-acceptance-deploy2.json /tmp/gryph-acceptance-terminal.py /usr/local/bin/gryph-acceptance /usr/share/polkit-1/actions/io.safedep.gryph.policy
exec rmdir --ignore-fail-on-non-empty /etc/safedep
exec gryph supervisor stop --user gryphacc1 --user gryphacc2
exec userdel -r gryphacc1
exec userdel -r gryphacc2
exec groupdel gryph-acceptance-admins
-- managed.yml --
policy:
  enabled: true
  log_all_evaluations: true
  approval:
    channels: [same-user-tty, local-admin]
    min_assurance: local-admin
    local_admin:
      group: gryph-acceptance-admins
      allow_self_elevated: true
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: /tmp/gryph-acceptance-spool
-- waived.yml --
policy:
  enabled: true
  log_all_evaluations: true
  approval:
    channels: [same-user-tty, local-admin]
    min_assurance: local-admin
    local_admin:
      group: gryph-acceptance-admins
      allow_self_elevated: true
      allow_without_auth: true
supervisor:
  enabled: true
  socket: /tmp/gryph-acceptance-hook.sock
  spool_dir: /tmp/gryph-acceptance-spool
-- policy.yaml --
version: "1"
rules:
  - id: acceptance-escalate-deploy
    action: escalate
    severity: high
    match:
      action_types: [command_exec]
      command_patterns:
        - "make deploy"
    message: "a deploy needs an admin"
-- io.safedep.gryph.policy --
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SafeDep</vendor>
  <vendor_url>https://safedep.io</vendor_url>
  <action id="io.safedep.gryph.approve">
    <description>Answer an approval request of Gryph</description>
    <message>Authenticate to answer the approval request</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
-- deploy.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "make deploy", "description": "x"},
  "tool_use_id": "tool-use-001"
}
-- deploy2.json --
{
  "session_id": "test-session-123",
  "cwd": "/home/user/project",
  "hook_event_name": "PreToolUse",
  "tool_name": "Bash",
  "tool_input": {"command": "make deploy", "description": "x"},
  "tool_use_id": "tool-use-002"
}
-- terminal.py --
# Run a hook with a pseudo terminal as its controlling terminal and answer
# the approval prompt there.
# usage: python3 terminal.py <answer|-> <payload|-> <command...>
# The payload file is the stdin of the hook, or a dash keeps the stdin of
# the helper. Stdout and stderr of the hook
# are pipes, as under an agent. The terminal gets the answer when a
# question that ends in [y/N] shows, and TERMINAL_PASSWORD when a line
# that ends in "Password:" shows. A dash gives no answer. A command that
# stays silent for a minute is killed. Everything the hook writes goes to
# stdout, and the exit code is the hook's.
import os
import pty
import select
import sys

answer, payload, command = sys.argv[1], sys.argv[2], sys.argv[3:]
out_r, out_w = os.pipe()
err_r, err_w = os.pipe()
pid, fd = pty.fork()
if pid == 0:
    # One descriptor keeps the terminal open after the standard ones
    # change, else the master reads end of file before the prompt.
    os.set_inheritable(os.dup(0), True)
    if payload != "-":
        os.dup2(os.open(payload, os.O_RDONLY), 0)
    os.dup2(out_w, 1)
    os.dup2(err_w, 2)
    os.execvp(command[0], command)
os.close(out_w)
os.close(err_w)
seen = b""
sent = False
password = os.environ.get("TERMINAL_PASSWORD")
password_sent = False
open_fds = {fd, out_r, err_r}
while open_fds:
    ready, _, _ = select.select(list(open_fds), [], [], 60)
    if not ready:
        os.kill(pid, 9)
        break
    for r in ready:
        try:
            data = os.read(r, 4096)
        except OSError:
            data = b""
        if not data:
            open_fds.discard(r)
            continue
        sys.stdout.write(data.decode("utf-8", "replace"))
        sys.stdout.flush()
        if r == fd:
            seen += data
            if not sent and answer != "-" and b"[y/N]" in seen:
                os.write(fd, (answer + "\n").encode())
                sent = True
            if password and not password_sent and b"Password:" in seen:
                os.write(fd, (password + "\n").encode())
                password_sent = True
_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
