# Under --managed, Gryph reads no HOME, XDG_* or GRYPH_* variable. The
# configuration lands in the system directory and nothing lands in the
# sandbox home. Runs only in the privileged job on a Linux host with no
# managed state.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
! exists /etc/safedep/gryph
! exists /etc/claude-code
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share
env GRYPH_CONFIG_DIR=$WORK/elsewhere
env GRYPH_POLICY_ENABLED=true
env GRYPH_MANAGED_AGENTS=codex
expandenv managed.yml

exec gryph install --managed --config $WORK/managed.yml --json
stdout '"status": "ok"'
stdout '"config": "/etc/safedep/gryph/config.yml"'
exists /etc/safedep/gryph/config.yml
exists /etc/claude-code/managed-settings.d/50-gryph.json
! exists /etc/codex/requirements.toml
! exists $WORK/home/.config/safedep/gryph
! exists $WORK/elsewhere
! grep 'enabled: true' /etc/safedep/gryph/config.yml

exec rm -rf /etc/safedep/gryph /etc/claude-code
exec rmdir --ignore-fail-on-non-empty /etc/safedep

-- managed.yml --
managed:
  agents: [claude-code]
  binary: ${ACCEPTANCE_GRYPH_BIN}
