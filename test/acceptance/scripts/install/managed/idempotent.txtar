# A second run with the same input changes nothing and exits 0. A dry run
# with a changed policy reports the change and writes nothing. A run that
# removes an agent from the allowlist removes its entries. Runs only in the
# privileged job on a Linux host with no managed state.
[!privileged] skip 'needs ACCEPTANCE_PRIVILEGED=1 and root'
[!linux] skip 'the managed paths of this script are the Linux ones'
! exists /etc/safedep/gryph
! exists /etc/claude-code
! exists /etc/codex
expandenv both.yml claude-only.yml

exec gryph install --managed --config $WORK/both.yml --json
stdout '"status": "ok"'
exists /etc/claude-code/managed-settings.d/50-gryph.json
exists /etc/codex/requirements.toml

exec gryph install --managed --config $WORK/both.yml --json
stdout '"status": "ok"'
stdout '"changed": false'
! stdout '"changed": true'

# A dry run compares the files: a new policy is a change, and nothing is
# written.
exec gryph install --managed --config $WORK/both.yml --policy $WORK/policy.yaml --dry-run --json
stdout '"status": "dry-run"'
stdout '"changed": true'
! exists /etc/safedep/gryph/policy.yaml

exec gryph install --managed --config $WORK/claude-only.yml --json
stdout '"name": "codex"'
stdout '"action": "remove"'
! grep '_hook codex' /etc/codex/requirements.toml
grep 'hooks = true' /etc/codex/requirements.toml
exists /etc/claude-code/managed-settings.d/50-gryph.json

exec rm -rf /etc/safedep/gryph /etc/claude-code /etc/codex
exec rm -rf /etc/systemd/user/gryph-reconcile.service /etc/systemd/user/gryph-reconcile.timer /etc/systemd/user/timers.target.wants/gryph-reconcile.timer
exec rmdir --ignore-fail-on-non-empty /etc/safedep

-- both.yml --
managed:
  agents: [claude-code, codex]
  binary: ${ACCEPTANCE_GRYPH_BIN}
-- claude-only.yml --
managed:
  agents: [claude-code]
  binary: ${ACCEPTANCE_GRYPH_BIN}
-- policy.yaml --
version: "1"
rules:
  - id: acceptance-dry-run-marker
    action: warn
    match:
      action_types: [file_write]
    message: marker
