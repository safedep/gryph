# A user export profile under export.profiles gives a treatment to a value by
# its origin or class. The first matching rule wins. A value that no rule
# matches gets the default treatment of the profile.
env HOME=$WORK/home
env XDG_CONFIG_HOME=$WORK/home/.config
env XDG_DATA_HOME=$WORK/home/.local/share

stdin prompt.json
exec gryph _hook claude-code UserPromptSubmit
stdin write.json
exec gryph _hook claude-code PostToolUse

exec gryph export --since 1h --export-profile team
stdout '"prompt":\{"value":"\[REDACTED\]"'
! stdout 'Rename the config loader'
! stdout 'WRITE_MARKER_7Q'
stdout '"digest":"hmac-sha256:'
! stdout '"digest":"sha256:'
stderr 'Exported 2 events'

-- home/.config/safedep/gryph/config.yml --
logging:
  level: full
export:
  profiles:
    team:
      default: digest
      rules:
        - origins: [user]
          then: redact
-- prompt.json --
{"session_id": "s-user-profile", "cwd": "/home/user/project", "hook_event_name": "UserPromptSubmit",
 "prompt": "Rename the config loader"}
-- write.json --
{"session_id": "s-user-profile", "cwd": "/home/user/project", "hook_event_name": "PostToolUse", "tool_name": "Write",
 "tool_input": {"file_path": "/home/user/project/main.go", "content": "package main // WRITE_MARKER_7Q"},
 "tool_response": {"success": true}, "tool_use_id": "tu-write"}
